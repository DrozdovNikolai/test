# ---- Host ports (published) ----
APP_PORT=3005
POSTGRES_PORT=5433
PUBLIC_BASE_PATH=/
VITE_API_URL=/api
ADMIN_API_KEY=change_me

# ---- Postgres (container) ----
POSTGRES_DB=profit_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ---- Backend (host defaults; compose overrides DB_HOST/DB_PORT) ----
NODE_ENV=production
# Важно: внутри docker контейнер backend слушает `PORT` (по умолчанию 3000). Снаружи используем `APP_PORT`.
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5433
DB_NAME=profit_db
DB_USER=postgres
DB_PASSWORD=change_me

DATABASE_URL=postgresql://postgres:change_me@localhost:5433/profit_db
